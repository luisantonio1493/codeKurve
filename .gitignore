# OS
.DS_Store

# Rust build output
target/

# CodeKurve local index / data directory
.codekurve/

# CodeGraph local index (the other tool's per-checkout index — each checkout
# builds its own, so it is never shared or committed)
.codegraph/

# Synthetic benchmark fixtures (generated at runtime by scripts/bench.py,
# not committed — design PR3 D13)
fixtures/bench/

# Agent-context benchmark output. Summaries are generated locally; raw Codex
# JSONL is only retained in an explicit debug directory outside this checkout.
benchmarks/agent-context/results/

# Gentle-AI generated skill registry (managed automatically)
.atl/.skill-registry.cache.json
.atl/skill-registry.md

# cargo-about NOTICE report (generated in CI, uploaded as a workflow artifact)
NOTICE-3rdparty.md

# Python bytecode cache (scripts/)
__pycache__/

# Editor temporary files
*.swp
*.swo
*~
.idea/
.vscode/
